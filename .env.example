OPENAI_API_KEY=

GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_CLIENT_SECRET_ID=
GRAPH_MAILBOX=test@tryrama.com

PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=
PGPASSWORD=
PGOPTIONS=-c search_path=worktrial

# Models (OpenAI)
EXTRACT_MODEL=gpt-5.5
AGENT_MODEL=gpt-5.5
TRIAGE_MODEL=gpt-5.4-mini
# Judges customer clauses no rule recognises (defaults to AGENT_MODEL)
JUDGE_MODEL=gpt-5.5

# Safety: replies only ever go to REPLY_TO, and nothing is sent unless DRY_RUN=0
REPLY_TO=test@tryrama.com
DRY_RUN=1

# Where documents are looked up when an email doesn't carry them: our SO acknowledgements and our PO PDFs to suppliers
ACK_DIR=data/order_docs

# Inbox watching
POLL_SECONDS=30
# Exact sender addresses never processed (comma separated), e.g. other testers in a shared mailbox
SUPPRESS_SENDERS=

# At most this many agents at once (one per email); ERP writes stay planned-only unless ERP_DRY_RUN=0
WATCH_WORKERS=5
ERP_DRY_RUN=1
